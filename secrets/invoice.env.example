# Local-only runtime secrets for staging/testing.
# Copy to secrets/invoice.env and fill with real values.
# This file is safe to commit; secrets/invoice.env is gitignored.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_SITE_URL=https://www.electroclimapro.us

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# MinIO root credentials (required for local MinIO startup)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# S3-compatible settings your app can use for file upload/download
S3_ENDPOINT=http://minio:9000
S3_BUCKET=invoice-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true

# AI invoice photo import (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: if using OpenRouter or another OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash

# Optional: size limit for evidence ZIP attached to invoice emails (bytes)
# EVIDENCE_ZIP_EMAIL_MAX_BYTES=20971520

# Optional: force template folder path (mostly for local development override)
# TEMPLATE_DIR=/templates

# Google Drive backup (host-side rclone sync)
GDRIVE_BACKUP_ENABLED=false
GDRIVE_REMOTE=gdrive:alexeisinvoice-backups
GDRIVE_RCLONE_CONFIG=/srv/invoice/secrets/rclone.conf
GDRIVE_BACKUP_INCLUDE_MINIO=true

# "Send to Google Drive" button on the invoice photos panel (in-container rclone).
# Defaults shown below match docker-compose.yml; override only if you change the mount.
# PHOTOS_RCLONE_CONFIG=/etc/rclone/rclone.conf
# PHOTOS_GDRIVE_REMOTE=gdrive:Invoices

SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
SMTP_USERNAME=alexoptano@yahoo.com
SMTP_PASSWORD=jpnodgrbboubnuxs
SMTP_FROM=alexoptano@yahoo.com