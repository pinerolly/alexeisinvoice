# Local-only runtime secrets for staging/testing.
# Copy to secrets/invoice.env and fill with real values.
# This file is safe to commit; secrets/invoice.env is gitignored.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# MinIO root credentials (required for local MinIO startup)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# S3-compatible settings your app can use for file upload/download
S3_ENDPOINT=http://minio:9000
S3_BUCKET=invoice-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true

# AI invoice photo import (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Drive backup (host-side rclone sync)
GDRIVE_BACKUP_ENABLED=false
GDRIVE_REMOTE=gdrive:alexeisinvoice-backups
GDRIVE_RCLONE_CONFIG=/srv/invoice/secrets/rclone.conf
GDRIVE_BACKUP_INCLUDE_MINIO=true
