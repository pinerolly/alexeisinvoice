[Unit]
Description=Export invoice PDFs and mirror them to Google Drive via rclone
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf
Environment=REMOTE=gdrive:Invoices
Environment=PROJECT_DIR=/home/ubuntu/docker/alexeisinvoice
ExecStart=/usr/local/bin/backup_invoices_to_gdrive.sh
