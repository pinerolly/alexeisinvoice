# Copy this file to ".env" (same directory as docker-compose.yml) and fill in
# real values. This .env is read by "docker compose" for variable substitution
# above; it is separate from goapp/.env used for local (non-Docker) runs.
#
# Login accounts are now managed inside the app (SQLite-backed users table).
# On first run a default "admin" / "admin" account is created automatically --
# log in and change the password from the Account page, and add more users
# (admin or regular) from the Users page. Nothing needs to be set here for auth.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
