# Copy this file to ".env" (same directory as docker-compose.yml).
# This file is only for docker-compose variable substitution.
# Runtime app secrets (SMTP, Plaid, S3, AI keys) belong in secrets/invoice.env.

# Path to runtime secrets file injected via compose env_file.
APP_SECRETS_FILE=./secrets/invoice.env

# Choose which Caddyfile to mount.
# Local/dev usually uses ./Caddyfile and production uses ./Caddyfile.production.
CADDYFILE_PATH=./Caddyfile

# Keep SQLite on local disk (not Samba/CIFS) to avoid SQLITE_BUSY lock issues.
INVOICE_DATA_DIR=/srv/invoice/data

# Optional named volume/custom path overrides.
MINIO_DATA_DIR=minio_data
CADDY_DATA_DIR=caddy_data
CADDY_CONFIG_DIR=caddy_config

# Optional public host used by Caddyfile.production
# SITE_HOST=www.electroclimapro.us

# Optional Infisical settings (only when using the "infisical" compose profile)
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
# INFISICAL_TOKEN=

# IMPORTANT:
# Do NOT place SMTP/S3/Plaid/OpenAI secrets in this file.
# Put runtime secrets in: secrets/invoice.env