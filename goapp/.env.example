# Copy this file to ".env" (same directory as this file) for local/native
# runs via "go run ." or "air". Used only when SMTP env vars aren't already
# set in the OS environment. Not read by docker-compose (see ../.env.example).

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Plaid (used to connect the business bank account and track incoming
# payments, e.g. Zelle deposits). Get these from the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
